<%- include('partials/head', { title: 'Login — SystemCall' }) %>

<style>
.login-wrapper {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: radial-gradient(circle at 70% 30%, rgba(16,185,129,0.12) 0%, transparent 50%),
                radial-gradient(circle at 30% 70%, rgba(59,130,246,0.1) 0%, transparent 50%),
                var(--bg-primary);
}
.login-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    max-width: 400px;
    margin: 0 auto;
}
.logo-mark {
    width: 64px; height: 64px;
    background: linear-gradient(135deg, var(--accent-primary), #3b82f6);
    border-radius: 18px;
    display: flex; align-items: center; justify-content: center;
    font-size: 2.25rem; font-weight: 800; color: white;
    box-shadow: 0 8px 24px rgba(16,185,129,0.35), inset 0 2px 4px rgba(255,255,255,0.3);
    margin: 0 auto 1rem auto;
    /* Optical alignment for the letter S */
    padding-top: 2px;
}
</style>

<div class="login-wrapper">
    <div class="login-card">
        <div style="text-align: center; margin-bottom: 2rem;">
            <div class="logo-mark">S</div>
            <h1 style="font-size: 1.5rem; font-weight: 600; color: var(--text-primary);">SystemCall</h1>
            <p style="color: var(--text-secondary); font-size: var(--text-sm); margin-top: 4px;">Sign in to continue</p>
        </div>

        <% if (error) { %>
            <div style="padding: 12px; background: rgba(239,68,68,0.1); border: 1px solid rgba(239,68,68,0.2); border-radius: 8px; color: #ef4444; font-size: 14px; text-align: center; margin-bottom: 1.5rem;">
                <%= error %>
            </div>
        <% } %>

        <div id="clerk-sign-in" style="display: flex; justify-content: center;"></div>
    </div>
</div>

<%- include('partials/scripts') %>
<script>
  // Wait for Clerk to be defined on window
  const initClerk = async () => {
      if (!window.Clerk) {
          setTimeout(initClerk, 50);
          return;
      }
      await Clerk.load();
      if (Clerk.isSignedIn) {
          window.location.href = '/dashboard';
      } else {
          const signInDiv = document.getElementById('clerk-sign-in');
          Clerk.mountSignIn(signInDiv, {
              forceRedirectUrl: '/dashboard'
          });
      }
  };
  
  window.addEventListener('load', initClerk);
  gsap.fromTo('.login-card', { y: 30, opacity: 0 }, { y: 0, opacity: 1, duration: 0.7, ease: 'power3.out' });
</script>
