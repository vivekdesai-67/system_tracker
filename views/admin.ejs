<%- include('partials/head', { title: 'Admin Panel — SystemCall' }) %>

<style>
.shell {
    min-height: 100vh;
    background:
        radial-gradient(circle at 85% -10%, rgba(16,185,129,0.1) 0%, transparent 45%),
        radial-gradient(circle at -10% 90%, rgba(59,130,246,0.08) 0%, transparent 45%),
        var(--bg-primary);
    background-attachment: fixed;
}
.topbar {
    position: sticky; top: 0; z-index: 100;
    display: flex; align-items: center; justify-content: space-between;
    padding: 16px 32px;
    background: var(--topbar-bg);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border-bottom: 1px solid var(--border-color);
}
.topbar-brand { 
    font-size: var(--text-xl); font-weight: 700; letter-spacing: -0.04em; 
    display: flex; align-items: center; gap: 12px; 
    color: var(--text-primary);
}
.brand-dot { width: 12px; height: 12px; border-radius: 50%; background: linear-gradient(135deg, #f59e0b, #ef4444); box-shadow: 0 0 12px rgba(239,68,68,0.5); }
.content { max-width: 1200px; margin: 0 auto; padding: 40px 32px; animation: slideUpFade 0.6s var(--transition-base) forwards; }

.glass {
    background: var(--glass-bg);
    backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-xl);
    box-shadow: var(--glass-shadow);
    padding: 24px;
}
/* Buttons are now in design-system.css */

.form-group { display: flex; flex-direction: column; gap: 4px; margin-bottom: 12px; }
.form-group label { font-size: 13px; font-weight: 500; color: var(--text-secondary); }
.form-input { padding: 8px 12px; font-size: 13px; border-radius: var(--radius-md); border: 1px solid var(--border-color); background: var(--input-bg); color: var(--text-primary); outline: none; transition: border-color 0.2s; }
.form-input:focus { border-color: var(--accent-primary); }

.data-table { width: 100%; border-collapse: collapse; margin-top: 8px; font-size: 13px; }
.data-table th { text-align: left; padding: 10px 16px; color: var(--text-secondary); font-weight: 600; border-bottom: 1px solid var(--border-color); text-transform: uppercase; font-size: 11px; letter-spacing: 0.05em; }
.data-table td { padding: 10px 16px; border-bottom: 1px solid var(--border-color); color: var(--text-primary); }
.data-table tr:hover td { background: var(--chip-bg); }

.alert { padding: 12px 16px; border-radius: var(--radius-md); font-size: var(--text-sm); margin-bottom: 24px; }
.alert-error { background: rgba(239,68,68,0.1); border: 1px solid rgba(239,68,68,0.3); color: #ef4444; }
.alert-success { background: rgba(16,185,129,0.1); border: 1px solid rgba(16,185,129,0.3); color: #10b981; }

.admin-layout {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 24px;
    align-items: start;
}

.hide-mobile { display: inline-block; }

.back-btn {
    padding: 0 16px 0 12px; height: 36px; width: auto; border-radius: 18px;
    display: inline-flex; align-items: center; justify-content: center; gap: 8px;
    font-size: 13px; font-weight: 600; text-decoration: none;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    background: rgba(255, 255, 255, 0.03); border: 1px solid var(--border-subtle);
    color: var(--text-secondary);
}
.back-btn svg { margin: 0; transition: transform 0.3s ease; opacity: 0.8; }
.back-btn:hover { background: rgba(255, 255, 255, 0.08); color: var(--text-primary); border-color: rgba(255,255,255,0.2); }
.back-btn:hover svg { transform: translateX(-4px); opacity: 1; }

@media (max-width: 900px) {
    .admin-layout {
        grid-template-columns: 1fr;
    }
}
@media (max-width: 768px) {
    .hide-mobile { display: none !important; }
    .hide-col-mobile { display: none !important; }
    .topbar { padding: 12px 16px; gap: 8px; }
    .topbar-brand { font-size: 16px; }
    
    .content { padding: 16px 12px; }
    
    .data-table th, .data-table td { padding: 8px 6px; font-size: 12px; }
    .data-table th { font-size: 10px; }
}
</style>

<div class="shell">
    <div class="topbar">
        <div class="topbar-brand">
            <div class="brand-dot"></div>
            <span class="hide-mobile">SystemCall</span> <span style="color: var(--text-muted); font-size: 14px; font-weight: 400; margin-left: 8px;">/ Admin Panel</span>
        </div>
        <div class="topbar-right">
            <a href="/" class="back-btn" title="Back to Dashboard">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
                Dashboard
            </a>
        </div>
    </div>

    <div class="content">
        <% if (error) { %> <div class="alert alert-error"><%= error %></div> <% } %>
        <% if (success) { %> <div class="alert alert-success"><%= success %></div> <% } %>

        <div class="admin-layout">
            
            <div style="min-width: 0;">
                <!-- Seniors & Admins Table -->
                <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px;">
                    <h2 style="font-size: 16px; font-weight: 600;">Seniors & Admins</h2>
                    <span style="font-size: 12px; color: var(--text-muted);"><%= users.filter(u => u.role !== 'junior').length %> Users</span>
                </div>
                <div class="glass" style="margin-bottom: 24px; padding: 8px 0; overflow-x: auto;">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th class="hide-col-mobile">Username</th>
                                <th class="hide-col-mobile">Role</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% users.filter(u => u.role !== 'junior').forEach(u => { %>
                                <tr>
                                    <td style="font-weight: 600;"><%= u.name %></td>
                                    <td class="hide-col-mobile"><%= u.username %></td>
                                    <td class="hide-col-mobile">
                                        <span style="background: var(--chip-bg); padding: 4px 8px; border-radius: 4px; border: 1px solid var(--border-color); text-transform: uppercase; font-size: 10px; font-weight: 700;">
                                            <%= u.role %>
                                        </span>
                                    </td>
                                    <td>
                                        <% if (u.id !== user.id) { %>
                                        <div style="display: flex; gap: 8px;">
                                            <button type="button" class="btn btn-secondary" style="padding: 4px 10px; font-size: 12px;" onclick="openAdminEditModal(<%= u.id %>, '<%= escape(u.name.replace(/'/g, "\'")) %>', '<%= escape(u.username.replace(/'/g, "\'")) %>', '<%= u.role %>', '<%= u.discord_id || '' %>')">Edit</button>
                                            <form action="/api/admin/users/<%= u.id %>/delete" method="POST" style="margin: 0;" onsubmit="return confirm('Delete this user completely?');">
                                                <button type="submit" class="btn-danger">Delete</button>
                                            </form>
                                        </div>
                                        <% } else { %>
                                            <span style="font-size: 12px; color: var(--text-muted);">You</span>
                                        <% } %>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>

                <!-- Juniors Table -->
                <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px;">
                    <h2 style="font-size: 16px; font-weight: 600;">Juniors</h2>
                    <span style="font-size: 12px; color: var(--text-muted);"><%= users.filter(u => u.role === 'junior').length %> Users</span>
                </div>
                <div class="glass" style="margin-bottom: 32px; padding: 8px 0; overflow-x: auto;">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th class="hide-col-mobile">Username</th>
                                <th class="hide-col-mobile">Role</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% users.filter(u => u.role === 'junior').forEach(u => { %>
                                <tr>
                                    <td style="font-weight: 600;"><%= u.name %></td>
                                    <td class="hide-col-mobile"><%= u.username %></td>
                                    <td class="hide-col-mobile">
                                        <span style="background: var(--chip-bg); padding: 4px 8px; border-radius: 4px; border: 1px solid var(--border-color); text-transform: uppercase; font-size: 10px; font-weight: 700;">
                                            <%= u.role %>
                                        </span>
                                    </td>
                                    <td>
                                        <div style="display: flex; gap: 8px;">
                                            <button type="button" class="btn btn-secondary" style="padding: 4px 10px; font-size: 12px;" onclick="openAdminEditModal(<%= u.id %>, '<%= escape(u.name.replace(/'/g, "\'")) %>', '<%= escape(u.username.replace(/'/g, "\'")) %>', '<%= u.role %>', '<%= u.discord_id || '' %>')">Edit</button>
                                            <form action="/api/admin/users/<%= u.id %>/delete" method="POST" style="margin: 0;" onsubmit="return confirm('Delete this user completely?');">
                                                <button type="submit" class="btn-danger">Delete</button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>

                <!-- Issues Table -->
                <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px;">
                    <h2 style="font-size: 16px; font-weight: 600;">All Issues</h2>
                    <span style="font-size: 12px; color: var(--text-muted);"><%= issues.length %> Total</span>
                </div>
                <div class="glass" style="padding: 8px 0; overflow-x: auto;">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Project</th>
                                <th>Title</th>
                                <th>Status</th>
                                <th>Senior</th>
                                <th>Junior</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% issues.forEach(i => { %>
                                <tr>
                                    <td>#<%= i.id %></td>
                                    <td><%= i.project_name %></td>
                                    <td style="font-weight: 500;"><%= i.title %></td>
                                    <td><%= i.status %></td>
                                    <td style="color: var(--text-secondary);"><%= i.created_name %></td>
                                    <td style="color: var(--text-secondary);"><%= i.assigned_name %></td>
                                    <td>
                                        <form action="/api/admin/issues/<%= i.id %>/delete" method="POST" style="margin: 0;" onsubmit="return confirm('Permanently delete this issue?');">
                                            <button type="submit" class="btn-danger">Delete</button>
                                        </form>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Create User Sidebar -->
            <div>
                <h2 style="font-size: 16px; font-weight: 600; margin-bottom: 12px;">Add New User</h2>
                <div class="glass" style="padding: 20px;">
                    <form action="/api/admin/users" method="POST">
                        <div class="form-group">
                            <label for="new_name">Name</label>
                            <input type="text" id="new_name" name="name" class="form-input" placeholder="e.g. John Doe" required autocomplete="name">
                        </div>
                        <div class="form-group">
                            <label for="new_username">Username</label>
                            <input type="text" id="new_username" name="username" class="form-input" placeholder="e.g. john" required autocomplete="username">
                        </div>
                        <div class="form-group">
                            <label for="new_password">Password</label>
                            <input type="password" id="new_password" name="password" class="form-input" placeholder="Default password" required autocomplete="new-password">
                        </div>
                        <div class="form-group">
                            <label for="new_role">Role</label>
                            <select id="new_role" name="role" class="form-input" required autocomplete="organization-title">
                                <option value="junior">Junior</option>
                                <option value="senior">Senior</option>
                                <option value="admin">Admin</option>
                            </select>
                        </div>
                        <button type="submit" class="btn btn-primary" style="width: 100%; margin-top: 12px; font-size: 13px; padding: 10px;">Create User</button>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>


<!-- Admin Edit User Modal -->
<div class="modal-overlay" id="adminEditModal">
    <div class="modal-card">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
            <h2 style="font-size: var(--text-lg); font-weight: 600;">Edit User</h2>
            <button class="icon-btn" onclick="document.getElementById('adminEditModal').classList.remove('active')" type="button">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
            </button>
        </div>
        <form id="adminEditForm" method="POST">
            <div class="form-group" style="margin-bottom: 16px;">
                <label>Username</label>
                <input id="admin_edit_username" type="text" class="form-input" disabled style="opacity: 0.5;">
            </div>
            <div class="form-group" style="margin-bottom: 16px;">
                <label>Display Name</label>
                <input id="admin_edit_name" name="name" type="text" class="form-input" required autocomplete="off">
            </div>
            <div class="form-group" style="margin-bottom: 24px;">
                <label>Role</label>
                <select id="admin_edit_role" name="role" class="form-input" required>
                    <option value="junior">Junior</option>
                    <option value="senior">Senior</option>
                    <option value="admin">Admin</option>
                </select>
            </div>
            <div style="display: flex; justify-content: flex-end;">
                <button type="submit" class="btn btn-primary">Save Changes</button>
            </div>
        </form>
    </div>
</div>

<script>
function openAdminEditModal(id, name, username, role) {
    document.getElementById('adminEditModal').classList.add('active');
    document.getElementById('adminEditForm').action = '/api/admin/users/' + id + '/edit';
    document.getElementById('admin_edit_name').value = unescape(name);
    document.getElementById('admin_edit_username').value = unescape(username);
    if(window.adminRoleChoices) window.adminRoleChoices.setChoiceByValue(role);
}
</script>


<!-- Choices.js Library & Custom Styling -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/choices.js/public/assets/styles/choices.min.css" />
<style>
.choices { margin-bottom: 0; } 
.choices__inner { background-color: var(--input-bg) !important; border: 1px solid var(--border-color) !important; border-radius: var(--radius-md) !important; min-height: 44px !important; display: flex !important; align-items: center !important; } 
.choices.is-focused .choices__inner { border-color: var(--accent-primary) !important; box-shadow: 0 0 0 4px rgba(16,185,129,0.15) !important; }
.choices__input { background-color: transparent !important; color: var(--text-primary) !important; } 
.choices__input::placeholder { color: var(--text-muted) !important; }
.choices__list--dropdown, .choices__list[aria-expanded] { background-color: var(--bg-secondary) !important; border: 1px solid var(--border-color) !important; border-radius: var(--radius-md) !important; color: var(--text-primary) !important; z-index: 1000 !important; } 
.choices__list--dropdown .choices__item { color: var(--text-primary) !important; background-color: transparent !important; }
.choices[data-type*="select-one"] .choices__button { filter: invert(1) opacity(0.5) !important; } 
.choices__list--dropdown .choices__item--selectable.is-highlighted { background-color: var(--accent-primary) !important; color: white !important; }
.choices__list--dropdown .choices__item--choice { border-bottom: 1px solid var(--border-subtle) !important; }
</style>
<script src="https://cdn.jsdelivr.net/npm/choices.js/public/assets/scripts/choices.min.js"></script>
<script>
document.addEventListener('DOMContentLoaded', () => {
    const newRoleEl = document.getElementById('new_role');
    if (newRoleEl) new Choices(newRoleEl, { searchEnabled: false, itemSelectText: '', shouldSort: false });
    
    const editRoleEl = document.getElementById('admin_edit_role');
    if (editRoleEl) window.adminRoleChoices = new Choices(editRoleEl, { searchEnabled: false, itemSelectText: '', shouldSort: false });
});
</script>

</body>
</html>
